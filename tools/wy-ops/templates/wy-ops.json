{
  "schema": 1,
  "project": "{{project}}",
  "product": "{{project}}",
  "rolePrefix": "{{prefix}}",
  "pmRole": "{{prefix}}pm",
  "commitRole": "{{prefix}}commit",
  "roles": [
    { "name": "{{prefix}}commit", "summary": "커밋·버전관리 전담", "agent": true },
    { "name": "{{prefix}}planner", "summary": "기획·아키텍처 결정, 요구사항·결정기록 담당", "agent": true },
    { "name": "{{prefix}}pm", "summary": "개발 총괄: 작업 지시, 보고 취합, 중요 결정을 사용자에게 올림", "agent": false },
    { "name": "{{prefix}}backend", "summary": "백엔드: 서버·공통 모듈·빌드", "agent": true },
    { "name": "{{prefix}}frontend", "summary": "프론트엔드: 화면·공용 컴포넌트·API 연결", "agent": true },
    { "name": "{{prefix}}qa", "summary": "사용성·기능 테스트: 구현 화면 검증, 요구사항과 대조", "agent": true }
  ],
  "rotation": { "transcriptMB": 5 },
  "memory": { "warnFreeMB": 1024, "blockFreeMB": 500 },
  "approvals": { "namespace": "{{project}}", "ttlMinutes": 60 },
  "docs": { "progress": "docs/진행현황.md", "decisions": "docs/결정기록.md" }
}
