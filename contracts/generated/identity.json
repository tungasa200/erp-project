{
  "components" : {
    "responses" : {
      "Unauthorized" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problem"
            }
          }
        },
        "description" : "토큰 없음·만료·서명 오류·aud 불일치 (code=UNAUTHENTICATED), 또는 탈퇴한 사용자 (code=USER_DELETED).\n프론트는 UNAUTHENTICATED일 때 refresh 1회 후 재시도한다 (P0-07)."
      }
    },
    "schemas" : {
      "AccountDeletionRequest" : {
        "properties" : {
          "password" : {
            "description" : "현재 비밀번호. errors[].field는 password",
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "password" ],
        "type" : "object"
      },
      "CodeCheckRequest" : {
        "properties" : {
          "code" : {
            "minLength" : 1,
            "pattern" : "^[0-9]{6}$",
            "type" : "string"
          },
          "email" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "code", "email" ],
        "type" : "object"
      },
      "CodeIssued" : {
        "description" : "코드를 새로 발급했을 때 화면의 카운트다운용 시각 (UTC)",
        "properties" : {
          "expiresAt" : {
            "description" : "코드 만료 시각 (발급 + 10분)",
            "format" : "date-time",
            "type" : "string"
          },
          "resendAvailableAt" : {
            "description" : "다시 받기를 누를 수 있는 시각 (발급 + 60초)",
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "CodeRejectedProblem" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/Problem"
        }, {
          "properties" : {
            "attemptsRemaining" : {
              "description" : "CODE_MISMATCH일 때만. 남은 시도 횟수 (0이면 다음부터 CODE_EXPIRED)",
              "type" : "integer"
            }
          },
          "type" : "object"
        } ]
      },
      "DeletedUser" : {
        "properties" : {
          "deletedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "userId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "deletedAt", "userId" ],
        "type" : "object"
      },
      "DeletedUserPage" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/DeletedUser"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "items" ],
        "type" : "object"
      },
      "EmailVerificationConfirmRequest" : {
        "properties" : {
          "code" : {
            "description" : "메일로 받은 6자리 숫자",
            "minLength" : 1,
            "pattern" : "^[0-9]{6}$",
            "type" : "string"
          }
        },
        "required" : [ "code" ],
        "type" : "object"
      },
      "EmailVerificationStatus" : {
        "properties" : {
          "attemptsRemaining" : {
            "description" : "유효한 코드의 남은 시도 횟수. 유효한 코드가 없으면 null",
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "expiresAt" : {
            "description" : "유효한 코드의 만료 시각. 유효한 코드가 없으면 null",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "resendAvailableAt" : {
            "description" : "다시 받을 수 있는 시각. 지금 받을 수 있으면 null. 하루 한도에 닿았으면 한도가 풀리는 시각",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "verified" : {
            "type" : "boolean"
          }
        },
        "required" : [ "verified" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "Me" : {
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "emailVerified" : {
            "type" : "boolean"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "keyboardShortcutsEnabled" : {
            "description" : "키보드 단축키 사용 (UX-09, 기본 켬). 모듈에는 전달하지 않는다.",
            "type" : "boolean"
          },
          "name" : {
            "type" : [ "string", "null" ]
          },
          "organization" : {
            "type" : [ "string", "null" ]
          },
          "position" : {
            "type" : [ "string", "null" ]
          },
          "themeAccent" : {
            "type" : "string"
          },
          "themeGround" : {
            "type" : "string"
          },
          "timezone" : {
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          },
          "weekStart" : {
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ],
            "type" : "string"
          },
          "workDays" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "email", "emailVerified", "id", "keyboardShortcutsEnabled", "themeAccent", "themeGround", "timezone", "version", "weekStart", "workDays" ],
        "type" : "object"
      },
      "PasswordChangeRequest" : {
        "properties" : {
          "currentPassword" : {
            "minLength" : 1,
            "type" : "string"
          },
          "newPassword" : {
            "description" : "8~64자, UTF-8 72바이트 이하, 영문·숫자 포함, 이메일과 다른 문자열 (D-38), 현재 비밀번호와 다른 문자열. errors[].field는 newPassword",
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "currentPassword", "newPassword" ],
        "type" : "object"
      },
      "PasswordChanged" : {
        "properties" : {
          "currentSessionKept" : {
            "description" : "true: 현재 기기는 로그인 유지, 다른 기기의 로그인 세션은 폐기. false: 현재 기기를 가려낼 수 없어 모든 로그인 세션을 폐기하고 쿠키를 지움",
            "type" : "boolean"
          }
        },
        "required" : [ "currentSessionKept" ],
        "type" : "object"
      },
      "PasswordResetConfirmRequest" : {
        "properties" : {
          "code" : {
            "minLength" : 1,
            "pattern" : "^[0-9]{6}$",
            "type" : "string"
          },
          "email" : {
            "minLength" : 1,
            "type" : "string"
          },
          "newPassword" : {
            "description" : "8~64자, UTF-8 72바이트 이하, 영문·숫자 포함, 이메일과 다른 문자열 (D-38). errors[].field는 newPassword",
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "code", "email", "newPassword" ],
        "type" : "object"
      },
      "PasswordResetRequest" : {
        "properties" : {
          "email" : {
            "description" : "가입과 같이 앞뒤 공백 제거·소문자로 비교한다",
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "email" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "RFC 9457 Problem Details + 확장 필드 (P0-10 공통 모듈 형식)",
        "properties" : {
          "code" : {
            "description" : "기계 판독용 오류 코드",
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "items" : {
              "properties" : {
                "code" : {
                  "type" : "string"
                },
                "field" : {
                  "type" : "string"
                },
                "message" : {
                  "type" : "string"
                }
              },
              "required" : [ "field", "code" ],
              "type" : "object"
            },
            "type" : "array"
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri-reference",
            "type" : "string"
          }
        },
        "required" : [ "type", "title", "status", "code", "traceId" ],
        "type" : "object"
      },
      "Profile" : {
        "properties" : {
          "name" : {
            "type" : [ "string", "null" ]
          },
          "organization" : {
            "type" : [ "string", "null" ]
          },
          "position" : {
            "type" : [ "string", "null" ]
          },
          "timezone" : {
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          },
          "weekStart" : {
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ],
            "type" : "string"
          },
          "workDays" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "timezone", "version", "weekStart", "workDays" ],
        "type" : "object"
      },
      "ProfileUpdateRequest" : {
        "description" : "보낸 칸만 수정한다. 칸 없음 = 그대로, null = 지움(이름·소속·직책만). 모르는 칸은 무시한다.",
        "properties" : {
          "keyboardShortcutsEnabled" : {
            "description" : "키보드 단축키 사용 (UX-09). 피드에는 남기지 않는다.",
            "type" : "boolean"
          },
          "name" : {
            "maxLength" : 100,
            "type" : [ "string", "null" ]
          },
          "organization" : {
            "maxLength" : 100,
            "type" : [ "string", "null" ]
          },
          "position" : {
            "description" : "표시용 직책 (권한용 역할과 별개)",
            "maxLength" : 100,
            "type" : [ "string", "null" ]
          },
          "timezone" : {
            "description" : "IANA 시간대 이름. 바꿔도 기존 기록 날짜는 그대로다 (D-40).",
            "example" : "Asia/Seoul",
            "type" : "string"
          },
          "version" : {
            "description" : "마지막으로 받은 Me.version",
            "format" : "int64",
            "type" : "integer"
          },
          "weekStart" : {
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ],
            "type" : "string"
          },
          "workDays" : {
            "description" : "비트마스크 월=1 … 일=64. 최소 하루는 골라야 한다.",
            "format" : "int32",
            "maximum" : 127,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      },
      "RateLimitedProblem" : {
        "allOf" : [ {
          "$ref" : "#/components/schemas/Problem"
        }, {
          "properties" : {
            "retryAfterSeconds" : {
              "description" : "다시 시도할 수 있을 때까지 남은 초. 잠금 안내 문구에 쓴다.",
              "type" : "integer"
            }
          },
          "required" : [ "retryAfterSeconds" ],
          "type" : "object"
        } ]
      },
      "SignupRequest" : {
        "properties" : {
          "agreePrivacy" : {
            "type" : "boolean"
          },
          "agreeTerms" : {
            "type" : "boolean"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "agreePrivacy", "agreeTerms", "email", "password" ],
        "type" : "object"
      },
      "UserEvent" : {
        "properties" : {
          "occurredAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "profile" : {
            "$ref" : "#/components/schemas/Profile",
            "description" : "CREATED·PROFILE_UPDATED에만 있음. DELETED는 null",
            "type" : [ "object", "null" ]
          },
          "seq" : {
            "format" : "int64",
            "type" : "integer"
          },
          "type" : {
            "enum" : [ "CREATED", "PROFILE_UPDATED", "DELETED" ],
            "type" : "string"
          },
          "userId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "occurredAt", "seq", "type", "userId" ],
        "type" : "object"
      },
      "UserEventPage" : {
        "properties" : {
          "hasMore" : {
            "type" : "boolean"
          },
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/UserEvent"
            },
            "type" : "array"
          }
        },
        "required" : [ "hasMore", "items" ],
        "type" : "object"
      },
      "UserItem" : {
        "properties" : {
          "profile" : {
            "$ref" : "#/components/schemas/Profile"
          },
          "userId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "profile", "userId" ],
        "type" : "object"
      },
      "UserPage" : {
        "properties" : {
          "asOfSeq" : {
            "format" : "int64",
            "type" : "integer"
          },
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/UserItem"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "asOfSeq", "items" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      },
      "serviceToken" : {
        "bearerFormat" : "JWT",
        "description" : "/internal/oauth/token으로 받은 서비스 토큰 (aud=erp-internal, scope 필수)",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "title" : "identity-service API",
    "version" : "v0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/.well-known/jwks.json" : {
      "get" : {
        "operationId" : "getJwks",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "additionalProperties" : { },
                  "type" : "object"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "JWT 서명 공개키 (내부 전용)",
        "tags" : [ "jwks" ]
      }
    },
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Me"
                }
              }
            },
            "description" : "로그인 성공. 쿠키 2종 발급"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "VALIDATION_FAILED"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "INVALID_CREDENTIALS"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RateLimitedProblem"
                }
              }
            },
            "description" : "계정 잠금(AUTH_LOCKED) 또는 IP 단위 시도 제한(TOO_MANY_REQUESTS). 남은 시간은 Retry-After(초)와 retryAfterSeconds",
            "headers" : {
              "Retry-After" : {
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          }
        },
        "summary" : "이메일·비밀번호 로그인",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
        "operationId" : "logout",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "refresh_token",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "세션 폐기, 쿠키 2종 삭제. 쿠키가 없거나 이미 폐기돼도 204"
          }
        },
        "summary" : "로그아웃",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/password-change" : {
      "post" : {
        "description" : "현재 비밀번호 확인 뒤 새 비밀번호(D-38)로 바꾼다. 현재 기기의 세션만 남기고 다른 기기의 로그인 세션을 폐기한다.",
        "operationId" : "changePassword",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "refresh_token",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordChangeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PasswordChanged"
                }
              }
            },
            "description" : "변경 완료. currentSessionKept=false이면 쿠키 2종을 지운다"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "CURRENT_PASSWORD_MISMATCH(errors[].field=currentPassword) 또는 VALIDATION_FAILED(REQUIRED, 비밀번호 규칙, PASSWORD_SAME_AS_CURRENT)"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "UNAUTHENTICATED 또는 USER_DELETED"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RateLimitedProblem"
                }
              }
            },
            "description" : "PASSWORD_CHANGE_LOCKED: 비밀번호 재확인 불일치(회원 탈퇴와 합산) 15분 안에 5회 → 15분 동안 비밀번호 변경·탈퇴를 막음. 남은 시간은 Retry-After(초)와 retryAfterSeconds",
            "headers" : {
              "Retry-After" : {
                "schema" : {
                  "type" : "integer"
                },
                "style" : "simple"
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ],
        "summary" : "비밀번호 변경 (AUTH-07, P4-08, SCR-SET-06)",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/password-reset" : {
      "post" : {
        "description" : "가입 여부와 관계없이 같은 202. 가입된 이메일이면 새 코드를 커밋 뒤 메일로 보낸다(이전 코드 무효).",
        "operationId" : "requestPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CodeIssued"
                }
              }
            },
            "description" : "접수 (가입 여부 비노출)"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
