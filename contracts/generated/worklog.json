    "/api/worklog/tasks" : {
      "get" : {
        "description" : "기본 조회는 보관(소프트 삭제)하지 않은 업무 중 보관한 프로젝트에 속하지 않은 것이다. projectId로 거르면 보관한 프로젝트의 업무도 돌려준다.\n정렬: sort=due는 마감일 오름차순(마감일 없음은 뒤) → 생성순, sort=created는 생성 역순.\n필터를 바꾸면 cursor 없이 처음부터 조회한다.",
        "operationId" : "listTasks",
        "parameters" : [ {
          "description" : "이전 응답의 nextCursor. 처음이면 생략.",
          "in" : "query",
          "name" : "cursor",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "default" : "50",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "string"
          }
        }, {
          "description" : "여러 개면 OR (?status=TODO&status=IN_PROGRESS)",
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "items" : {
              "enum" : [ "TODO", "IN_PROGRESS", "DONE", "ON_HOLD" ],
              "type" : "string"
            },
            "type" : "array"
          }
        }, {
          "description" : "여러 개면 OR",
          "in" : "query",
          "name" : "projectId",
          "required" : false,
          "schema" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          }
        }, {
          "description" : "여러 개면 OR (태그 중 하나라도 붙은 업무)",
          "in" : "query",
          "name" : "tagId",
          "required" : false,
          "schema" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          }
        }, {
          "description" : "마감일 >= dueFrom",
          "in" : "query",
          "name" : "dueFrom",
          "required" : false,
          "schema" : {
            "format" : "date",
            "type" : "string"
          }
        }, {
          "description" : "마감일 <= dueTo",
          "in" : "query",
          "name" : "dueTo",
          "required" : false,
          "schema" : {
            "format" : "date",
            "type" : "string"
          }
        }, {
          "description" : "완료 업무는 완료 시각이 이 시각 이후인 것만 (완료가 아닌 업무에는 영향 없음)",
          "in" : "query",
          "name" : "completedSince",
          "required" : false,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        }, {
          "description" : "제목 부분 일치 검색 (대소문자 무시)",
          "in" : "query",
          "name" : "q",
          "required" : false,
          "schema" : {
            "maxLength" : 100,
            "type" : "string"
          }
        }, {
          "description" : "true면 보관(소프트 삭제)한 업무만 돌려준다",
          "in" : "query",
          "name" : "deleted",
          "required" : false,
          "schema" : {
