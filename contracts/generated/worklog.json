{
  "components" : {
    "responses" : {
      "Unauthorized" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problem"
            }
          }
        },
        "description" : "토큰 없음·만료·서명 오류·aud 불일치 (code=UNAUTHENTICATED), 또는 탈퇴한 사용자 (code=USER_DELETED).\n프론트는 UNAUTHENTICATED일 때 refresh 1회 후 재시도한다 (P0-07)."
      }
    },
    "schemas" : {
      "Problem" : {
        "description" : "RFC 9457 Problem Details + 확장 필드 (P0-10 공통 모듈 형식)",
        "properties" : {
          "code" : {
            "description" : "기계 판독용 오류 코드",
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "items" : {
              "properties" : {
                "code" : {
                  "type" : "string"
                },
                "field" : {
                  "type" : "string"
                },
                "message" : {
                  "type" : "string"
                }
              },
              "required" : [ "field", "code" ],
              "type" : "object"
            },
            "type" : "array"
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri-reference",
            "type" : "string"
          }
        },
        "required" : [ "type", "title", "status", "code", "traceId" ],
        "type" : "object"
      },
      "ProfileSnapshot" : {
        "properties" : {
          "name" : {
            "type" : [ "string", "null" ]
          },
          "organization" : {
            "type" : [ "string", "null" ]
          },
          "position" : {
            "type" : [ "string", "null" ]
          },
          "syncedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "timezone" : {
            "example" : "Asia/Seoul",
            "type" : "string"
          },
          "weekStart" : {
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ],
            "type" : "string"
          },
          "workDays" : {
            "description" : "비트마스크 월=1 … 일=64, 기본 31(월~금)",
            "format" : "int32",
            "maximum" : 127,
            "minimum" : 0,
            "type" : "integer"
          }
        },
        "required" : [ "timezone", "weekStart", "workDays" ],
        "type" : "object"
      },
      "Project" : {
        "properties" : {
          "archived" : {
            "type" : "boolean"
          },
          "archivedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "color" : {
            "description" : "프로젝트 전용 팔레트 8색의 키 (실제 색 값은 프론트 디자인 토큰)",
            "enum" : [ "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8" ],
            "type" : "string"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "maxLength" : 50,
            "type" : "string"
          },
          "taskCount" : {
            "description" : "보관(소프트 삭제)하지 않은 업무 수 (상태 무관)",
            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "archived", "color", "createdAt", "id", "name", "taskCount", "version" ],
        "type" : "object"
      },
      "ProjectCreate" : {
        "properties" : {
          "color" : {
            "enum" : [ "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8" ],
            "pattern" : "^P[1-8]$",
            "type" : "string"
          },
          "name" : {
            "description" : "앞뒤 공백은 빼고 저장한다",
            "maxLength" : 50,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "color", "name" ],
        "type" : "object"
      },
      "ProjectList" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/Project"
            },
            "type" : "array"
          }
        },
        "required" : [ "items" ],
        "type" : "object"
      },
      "ProjectPatch" : {
        "properties" : {
          "archived" : {
            "type" : "boolean"
          },
          "color" : {
            "enum" : [ "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8" ],
            "pattern" : "^P[1-8]$",
            "type" : "string"
          },
          "name" : {
            "maxLength" : 50,
            "minLength" : 0,
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      },
      "Tag" : {
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "description" : "#은 붙이지 않는다",
            "type" : "string"
          },
          "usageCount" : {
            "description" : "이 태그가 붙은 업무 중 보관하지 않은 업무 수",
            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "createdAt", "id", "name", "usageCount", "version" ],
        "type" : "object"
      },
      "TagCreate" : {
        "properties" : {
          "name" : {
            "maxLength" : 30,
            "minLength" : 0,
            "pattern" : "^[^\\s#]+$",
            "type" : "string"
          }
        },
        "required" : [ "name" ],
        "type" : "object"
      },
      "TagList" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/Tag"
            },
            "type" : "array"
          }
        },
        "required" : [ "items" ],
        "type" : "object"
      },
      "TagPatch" : {
        "properties" : {
          "name" : {
            "maxLength" : 30,
            "minLength" : 0,
            "pattern" : "^[^\\s#]+$",
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "name", "version" ],
        "type" : "object"
      },
      "Task" : {
        "properties" : {
          "carriedOverFromId" : {
            "description" : "이월 원본 업무 (읽기 전용, 이월 기능은 P3)",
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "completedAt" : {
            "description" : "status가 DONE일 때만 값이 있다",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "deletedAt" : {
            "description" : "보관(소프트 삭제) 시각. 값이 있으면 읽기 전용",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "dueDate" : {
            "description" : "마감 임박·초과 표시는 프론트가 사용자 시간대의 오늘과 비교해 계산한다",
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "memo" : {
            "maxLength" : 5000,
            "type" : [ "string", "null" ]
          },
          "priority" : {
            "enum" : [ "HIGH", "NORMAL", "LOW" ],
            "type" : "string"
          },
          "progress" : {
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 0,
            "multipleOf" : 10.0,
            "type" : "integer"
          },
          "projectId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "enum" : [ "TODO", "IN_PROGRESS", "DONE", "ON_HOLD" ],
            "type" : "string"
          },
          "tagIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          },
          "title" : {
            "maxLength" : 200,
            "type" : "string"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "createdAt", "id", "priority", "progress", "status", "tagIds", "title", "updatedAt", "version" ],
        "type" : "object"
      },
      "TaskCreate" : {
        "description" : "status 기본 TODO, priority 기본 NORMAL. status=DONE으로 만들면 completedAt을 기록한다.",
        "properties" : {
          "dueDate" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "memo" : {
            "maxLength" : 5000,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "priority" : {
            "enum" : [ "HIGH", "NORMAL", "LOW" ],
            "pattern" : "^(HIGH|NORMAL|LOW)$",
            "type" : "string"
          },
          "progress" : {
            "default" : 0,
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 0,
            "multipleOf" : 10.0,
            "type" : "integer"
          },
          "projectId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "enum" : [ "TODO", "IN_PROGRESS", "DONE", "ON_HOLD" ],
            "pattern" : "^(TODO|IN_PROGRESS|DONE|ON_HOLD)$",
            "type" : "string"
          },
          "tagIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          },
          "title" : {
            "description" : "앞뒤 공백은 빼고 저장한다",
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "title" ],
        "type" : "object"
      },
      "TaskList" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/Task"
            },
            "type" : "array"
          },
          "nextCursor" : {
            "description" : "다음 페이지가 없으면 null",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "items" ],
        "type" : "object"
      },
      "TaskPatch" : {
        "properties" : {
          "dueDate" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "memo" : {
            "maxLength" : 5000,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          },
          "priority" : {
            "enum" : [ "HIGH", "NORMAL", "LOW" ],
            "pattern" : "^(HIGH|NORMAL|LOW)$",
            "type" : "string"
          },
          "progress" : {
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 0,
            "multipleOf" : 10.0,
            "type" : "integer"
          },
          "projectId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "enum" : [ "TODO", "IN_PROGRESS", "DONE", "ON_HOLD" ],
            "pattern" : "^(TODO|IN_PROGRESS|DONE|ON_HOLD)$",
            "type" : "string"
          },
          "tagIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          },
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      },
      "WorklogMe" : {
        "properties" : {
          "profile" : {
            "$ref" : "#/components/schemas/ProfileSnapshot"
          },
          "settings" : {
            "$ref" : "#/components/schemas/WorklogSettings"
          },
          "userId" : {
            "description" : "UUIDv7, JWT sub와 같음",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "profile", "settings", "userId" ],
        "type" : "object"
      },
      "WorklogSettings" : {
        "properties" : {
          "dailyCloseTime" : {
            "description" : "사용자 시간대 기준 하루 마감 시각",
            "example" : "18:00",
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          },
          "timeTrackingEnabled" : {
            "type" : "boolean"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          },
          "workHoursEnd" : {
            "description" : "workHoursStart보다 늦어야 한다 (자정 넘는 업무 시간대 없음)",
            "example" : "18:00",
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          },
          "workHoursStart" : {
            "description" : "사용자 시간대 기준 HH:mm",
            "example" : "09:00",
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          }
        },
        "required" : [ "dailyCloseTime", "timeTrackingEnabled", "version", "workHoursEnd", "workHoursStart" ],
        "type" : "object"
      },
      "WorklogSettingsPatch" : {
        "properties" : {
          "dailyCloseTime" : {
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          },
          "timeTrackingEnabled" : {
            "type" : "boolean"
          },
          "version" : {
            "description" : "마지막으로 받은 version (행이 없으면 0)",
            "format" : "int64",
            "type" : "integer"
          },
          "workHoursEnd" : {
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          },
          "workHoursStart" : {
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "accessTokenCookie" : {
        "in" : "cookie",
        "name" : "access_token",
        "type" : "apiKey"
      }
    }
  },
  "info" : {
    "title" : "worklog-service API",
    "version" : "v0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/worklog/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorklogMe"
                }
              }
            },
            "description" : "조회 성공"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "사본이 없고 identity 조회도 실패함 (code=PROFILE_UNAVAILABLE). 잠시 후 재시도."
          }
        },
        "security" : [ {
          "accessTokenCookie" : [ ]
        } ],
        "summary" : "현재 사용자의 worklog 프로필 조회",
        "tags" : [ "me" ]
      }
    },
    "/api/worklog/me/profile/refresh" : {
      "post" : {
        "description" : "identity에서 프로필을 저장한 직후 호출한다. identity 값이 사본보다 새것(version)일 때만 바꾼다.",
        "operationId" : "refreshMyProfile",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorklogMe"
                }
              }
            },
            "description" : "갱신 후 현재 값"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "identity 조회 실패 (code=PROFILE_UNAVAILABLE). 잠시 후 재시도."
          }
        },
        "security" : [ {
          "accessTokenCookie" : [ ]
        } ],
        "summary" : "공통 프로필 사본 즉시 갱신 (P1-01)",
        "tags" : [ "me" ]
      }
    },
    "/api/worklog/me/settings" : {
      "patch" : {
        "description" : "보낸 칸만 바꾼다. 설정 행이 없으면 version=0으로 보낸다.",
        "operationId" : "updateMySettings",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/WorklogSettingsPatch"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorklogSettings"
                }
              }
            },
            "description" : "수정 후 설정 전체"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "입력 오류 (code=VALIDATION_FAILED). errors[].code: REQUIRED, INVALID_FORMAT, INVALID_ORDER"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "다른 곳에서 먼저 수정됨 (code=VERSION_CONFLICT)"
          }
        },
        "security" : [ {
          "accessTokenCookie" : [ ]
        } ],
        "summary" : "worklog 전용 설정 수정 (P1-01, 항목별 자동 저장)",
        "tags" : [ "me" ]
      }
    },
    "/api/worklog/projects" : {
      "get" : {
        "description" : "페이지 없이 전체를 돌려준다. 만든 순서.",
        "operationId" : "listProjects",
        "parameters" : [ {
          "description" : "true면 보관한 프로젝트도 포함",
          "in" : "query",
          "name" : "includeArchived",
          "required" : false,
          "schema" : {
            "default" : false,
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProjectList"
                }
              }
            },
            "description" : "조회 성공"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          }
        },
        "security" : [ {
          "accessTokenCookie" : [ ]
        } ],
        "summary" : "프로젝트 목록",
        "tags" : [ "projects" ]
      },
      "post" : {
        "operationId" : "createProject",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ProjectCreate"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Project"
                }
              }
            },
            "description" : "생성됨"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "입력 오류 (code=VALIDATION_FAILED)"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "같은 이름이 이미 있음 (code=DUPLICATE_NAME)"
          }
        },
        "security" : [ {
          "accessTokenCookie" : [ ]
        } ],
        "summary" : "프로젝트 추가",
        "tags" : [ "projects" ]
      }
    },
    "/api/worklog/projects/{projectId}" : {
      "get" : {
        "operationId" : "getProject",
