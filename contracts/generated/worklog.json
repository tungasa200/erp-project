{
  "components" : {
    "responses" : {
      "Unauthorized" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problem"
            }
          }
        },
        "description" : "토큰 없음·만료·서명 오류·aud 불일치 (code=UNAUTHENTICATED), 또는 탈퇴한 사용자 (code=USER_DELETED).\n프론트는 UNAUTHENTICATED일 때 refresh 1회 후 재시도한다 (P0-07)."
      }
    },
    "schemas" : {
      "Problem" : {
        "description" : "RFC 9457 Problem Details + 확장 필드 (P0-10 공통 모듈 형식)",
        "properties" : {
          "code" : {
            "description" : "기계 판독용 오류 코드",
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "items" : {
              "properties" : {
                "code" : {
                  "type" : "string"
                },
                "field" : {
                  "type" : "string"
                },
                "message" : {
                  "type" : "string"
                }
              },
              "required" : [ "field", "code" ],
              "type" : "object"
            },
            "type" : "array"
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri-reference",
            "type" : "string"
          }
        },
        "required" : [ "type", "title", "status", "code", "traceId" ],
        "type" : "object"
      },
      "ProfileSnapshot" : {
        "properties" : {
          "name" : {
            "type" : [ "string", "null" ]
          },
          "organization" : {
            "type" : [ "string", "null" ]
          },
          "position" : {
            "type" : [ "string", "null" ]
          },
          "syncedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "timezone" : {
            "example" : "Asia/Seoul",
            "type" : "string"
          },
          "weekStart" : {
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ],
            "type" : "string"
          },
          "workDays" : {
            "description" : "비트마스크 월=1 … 일=64, 기본 31(월~금)",
            "format" : "int32",
            "maximum" : 127,
            "minimum" : 0,
            "type" : "integer"
          }
        },
        "required" : [ "timezone", "weekStart", "workDays" ],
        "type" : "object"
      },
      "WorklogMe" : {
        "properties" : {
          "profile" : {
            "$ref" : "#/components/schemas/ProfileSnapshot"
          },
          "settings" : {
            "$ref" : "#/components/schemas/WorklogSettings"
          },
          "userId" : {
            "description" : "UUIDv7, JWT sub와 같음",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "profile", "settings", "userId" ],
        "type" : "object"
      },
      "WorklogSettings" : {
        "properties" : {
          "dailyCloseTime" : {
            "pattern" : "^\\d{2}:\\d{2}$",
            "type" : [ "string", "null" ]
          },
          "timeTrackingEnabled" : {
            "type" : "boolean"
          },
          "workHoursEnd" : {
            "pattern" : "^\\d{2}:\\d{2}$",
            "type" : [ "string", "null" ]
          },
          "workHoursStart" : {
            "pattern" : "^\\d{2}:\\d{2}$",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "timeTrackingEnabled" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "accessTokenCookie" : {
        "in" : "cookie",
        "name" : "access_token",
        "type" : "apiKey"
      }
    }
  },
  "info" : {
    "title" : "worklog-service API",
    "version" : "v0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/worklog/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorklogMe"
                }
              }
            },
            "description" : "조회 성공"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "사본이 없고 identity 조회도 실패함 (code=PROFILE_UNAVAILABLE). 잠시 후 재시도."
          }
        },
        "security" : [ {
          "accessTokenCookie" : [ ]
        } ],
        "summary" : "현재 사용자의 worklog 프로필 조회",
        "tags" : [ "me" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
