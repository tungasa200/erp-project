{
  "components" : {
    "responses" : {
      "Unauthorized" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/Problem"
            }
          }
        },
        "description" : "토큰 없음·만료·서명 오류·aud 불일치 (code=UNAUTHENTICATED), 또는 탈퇴한 사용자 (code=USER_DELETED).\n프론트는 UNAUTHENTICATED일 때 refresh 1회 후 재시도한다 (P0-07)."
      }
    },
    "schemas" : {
      "Problem" : {
        "description" : "RFC 9457 Problem Details + 확장 필드 (P0-10 공통 모듈 형식)",
        "properties" : {
          "code" : {
            "description" : "기계 판독용 오류 코드",
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "items" : {
              "properties" : {
                "code" : {
                  "type" : "string"
                },
                "field" : {
                  "type" : "string"
                },
                "message" : {
                  "type" : "string"
                }
              },
              "required" : [ "field", "code" ],
              "type" : "object"
            },
            "type" : "array"
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri-reference",
            "type" : "string"
          }
        },
        "required" : [ "type", "title", "status", "code", "traceId" ],
        "type" : "object"
      },
      "ProfileSnapshot" : {
        "properties" : {
          "name" : {
            "type" : [ "string", "null" ]
          },
          "organization" : {
            "type" : [ "string", "null" ]
          },
          "position" : {
            "type" : [ "string", "null" ]
          },
          "syncedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "timezone" : {
            "example" : "Asia/Seoul",
            "type" : "string"
          },
          "weekStart" : {
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ],
            "type" : "string"
          },
          "workDays" : {
            "description" : "비트마스크 월=1 … 일=64, 기본 31(월~금)",
            "format" : "int32",
            "maximum" : 127,
            "minimum" : 0,
            "type" : "integer"
          }
        },
        "required" : [ "timezone", "weekStart", "workDays" ],
        "type" : "object"
      },
      "WorklogMe" : {
        "properties" : {
          "profile" : {
            "$ref" : "#/components/schemas/ProfileSnapshot"
          },
          "settings" : {
            "$ref" : "#/components/schemas/WorklogSettings"
          },
          "userId" : {
            "description" : "UUIDv7, JWT sub와 같음",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "profile", "settings", "userId" ],
        "type" : "object"
      },
      "WorklogSettings" : {
        "properties" : {
          "dailyCloseTime" : {
            "description" : "사용자 시간대 기준 하루 마감 시각",
            "example" : "18:00",
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          },
          "timeTrackingEnabled" : {
            "type" : "boolean"
          },
          "version" : {
            "format" : "int64",
            "type" : "integer"
          },
          "workHoursEnd" : {
            "description" : "workHoursStart보다 늦어야 한다 (자정 넘는 업무 시간대 없음)",
            "example" : "18:00",
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          },
          "workHoursStart" : {
            "description" : "사용자 시간대 기준 HH:mm",
            "example" : "09:00",
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          }
        },
        "required" : [ "dailyCloseTime", "timeTrackingEnabled", "version", "workHoursEnd", "workHoursStart" ],
        "type" : "object"
      },
      "WorklogSettingsPatch" : {
        "properties" : {
          "dailyCloseTime" : {
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          },
          "timeTrackingEnabled" : {
            "type" : "boolean"
          },
          "version" : {
            "description" : "마지막으로 받은 version (행이 없으면 0)",
            "format" : "int64",
            "type" : "integer"
          },
          "workHoursEnd" : {
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          },
          "workHoursStart" : {
            "pattern" : "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type" : "string"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "accessTokenCookie" : {
        "in" : "cookie",
        "name" : "access_token",
        "type" : "apiKey"
      }
    }
  },
  "info" : {
    "title" : "worklog-service API",
    "version" : "v0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/worklog/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorklogMe"
                }
              }
            },
            "description" : "조회 성공"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "사본이 없고 identity 조회도 실패함 (code=PROFILE_UNAVAILABLE). 잠시 후 재시도."
          }
        },
        "security" : [ {
          "accessTokenCookie" : [ ]
        } ],
        "summary" : "현재 사용자의 worklog 프로필 조회",
        "tags" : [ "me" ]
      }
    },
    "/api/worklog/me/profile/refresh" : {
      "post" : {
        "description" : "identity에서 프로필을 저장한 직후 호출한다. identity 값이 사본보다 새것(version)일 때만 바꾼다.",
        "operationId" : "refreshMyProfile",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorklogMe"
                }
              }
            },
            "description" : "갱신 후 현재 값"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "identity 조회 실패 (code=PROFILE_UNAVAILABLE). 잠시 후 재시도."
          }
        },
        "security" : [ {
          "accessTokenCookie" : [ ]
        } ],
        "summary" : "공통 프로필 사본 즉시 갱신 (P1-01)",
        "tags" : [ "me" ]
      }
    },
    "/api/worklog/me/settings" : {
      "patch" : {
        "description" : "보낸 칸만 바꾼다. 설정 행이 없으면 version=0으로 보낸다.",
        "operationId" : "updateMySettings",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/WorklogSettingsPatch"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorklogSettings"
                }
              }
            },
            "description" : "수정 후 설정 전체"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "입력 오류 (code=VALIDATION_FAILED). errors[].code: REQUIRED, INVALID_FORMAT, INVALID_ORDER"
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "다른 곳에서 먼저 수정됨 (code=VERSION_CONFLICT)"
          }
        },
        "security" : [ {
          "accessTokenCookie" : [ ]
        } ],
        "summary" : "worklog 전용 설정 수정 (P1-01, 항목별 자동 저장)",
        "tags" : [ "me" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
